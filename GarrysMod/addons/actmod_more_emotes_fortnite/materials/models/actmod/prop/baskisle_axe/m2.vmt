"VertexlitGeneric"
{
	"$basetexture" "models/actmod/prop/baskIsle_axe/t_g"
   	"$vertexcolor" "1"
    	"$vertexalpha" "1"

	//"$model" "1"
	"$phong" "1"
	"$phongexponent" "10"
	"$phongboost" "0.2"
	"$phongalbedotint" "1"
	"$phongtint" "[.5 .5 .5]"
	"$phongfresnelranges"	"[0.5 6 10]"
	"$ambientocclusion" "1"
	//"$alpha" 0.1

    "Proxies"
    {
        "Sine"               // موجة تتذبذب بشكل دوري
        {
            "resultVar" "$alpha"     // المتغير الذي تعدّله
            "sinePeriod" "1"       // سرعة الوميض (كلما قل الرقم زادت السرعة)
            "sineMin" "0.38"          // أقل قيمة للشفافية
            "sineMax" "0.4"          // أعلى قيمة للشفافية
        }
    }

}
