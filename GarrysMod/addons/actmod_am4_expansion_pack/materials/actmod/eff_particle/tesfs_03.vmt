UnlitGeneric
{
    $basetexture "actmod/eff_particle/tesfs_e03"
    $vertexcolor 1
    $vertexalpha 1

    "$detail" "actmod/eff_particle/tesfs_03"
    "$detailscale" "0.5"
    "$detailblendfactor" "1"
    "$detailblendmode" "44"

    "$my_center" "[0 0]"
    "$my_scale" "[2 2]"
    "$my_angle" "0"
    "$my_translate" "[0 0]"

    "Proxies"
    {
	"TextureScroll"
        {
            "texturescrollvar" "$basetexturetransform"
            "texturescrollrate" "-0.5"
            "texturescrollangle" "90"
        }
	"TextureTransform"
        {
            "centerVar"    "$my_center"
            "scaleVar"     "$my_scale"
            "rotateVar"    "$my_angle"
            "translateVar" "$my_translate"
            "resultVar"    "$detailtexturetransform"
        }
    }
}
